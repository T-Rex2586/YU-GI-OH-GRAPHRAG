# ============================================================================
# Konfigurasi Yu-Gi-Oh! Hybrid GraphRAG (Neo4j + Google Gemini API)
# Salin file ini menjadi `.env` lalu isi API Key & kredensial Neo4j Anda
# ============================================================================

# Google Gemini API Key (Dapatkan gratis di: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini LLM & Provider Vector Embedding ('fastembed' lokal 768d atau 'gemini')
GEMINI_LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-base-en-v1.5
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Konfigurasi Neo4j (Default cocok dengan `docker compose up -d`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yugioh_graphrag_2026
NEO4J_DATABASE=neo4j
